# Copy to .env (NEVER commit .env). Values come from the Agent Games dashboard.
# HMAC secret: Dashboard -> agent -> "Rotate Secret" (shown ONCE). Same secret
# is used by both servers (one secret per agent registration).
AGENT_GAMES_HMAC_SECRET=
# Ports: each server reads PORT (default 3001 gatekeeper, 3002 steal).
# Run them as e.g. PORT=3001 node gatekeeper/server.cjs
# and PORT=3002 node steal/server.cjs (or set PORT in each .env/hosting config).
# The platform needs a PUBLIC https URL, e.g. https://<host>/agent — see README.
# Steal only: ONE fixed salt for the whole tournament.
# Generate with: node steal/gen-commitment.cjs
# Then paste the printed STRATEGY_COMMITMENT into the dashboard BEFORE Swiss Round 1.
STEAL_SALT=
STRATEGY_COMMITMENT=
# Strategy params (default 10,50,0,0,0,0,0,0). Only change BEFORE registering
# the commitment — changing params after registration invalidates it.
STRATEGY_PARAMS=10,50,0,0,0,0,0,0
